rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 실제 미로 기록 (스마트폰 조종 페이지의 시작·도착 버튼): 별명 1~10글자
    match /tiltmaze_real_records/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['name', 'time', 'device', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 10
        && request.resource.data.time is number
        && request.resource.data.time >= 5 && request.resource.data.time <= 3600
        && request.resource.data.device is string && request.resource.data.device.size() <= 24
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdAt > request.time - duration.value(10, 'm')
        && request.resource.data.createdAt < request.time + duration.value(10, 'm');
      allow update, delete: if false;
    }
  }
}
